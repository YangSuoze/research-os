# 复制为本目录的 .env，并填写 LLM 配置；不要提交真实密钥。
# 配置沿用 BACKEND_ 前缀。MCP 从任意工作目录启动都会读取本目录的 .env。

# LLM：必须替换为实际服务的 OpenAI-compatible API 地址和模型名称。
BACKEND_LLM_BASE_URL=https://your-llm-provider.example/v1
BACKEND_LLM_API_KEY=
BACKEND_MODEL_NAME=your-model-name

# 工作区默认使用仓库根目录下的 data/workspace，无需配置。
# 自定义存储目录时填写绝对路径，避免随启动目录改变。
# BACKEND_WORKSPACE_ROOT=/absolute/path/to/data/workspace
BACKEND_LOG_LEVEL=INFO

# Elasticsearch：匹配仓库根目录 compose.yaml 的本地开发配置。
# 默认关闭认证，用户名和密码留空。
BACKEND_ELASTICSEARCH_URL=http://localhost:9200
BACKEND_ELASTICSEARCH_INDEX=paper_chunks_v1
BACKEND_ELASTICSEARCH_USERNAME=
BACKEND_ELASTICSEARCH_PASSWORD=

# Neo4j：默认密码仅用于本地开发。
# 如果修改了 Compose 的 NEO4J_PASSWORD，此处需要填写相同密码。
BACKEND_NEO4J_URI=bolt://localhost:7687
BACKEND_NEO4J_USER=neo4j
BACKEND_NEO4J_PASSWORD=12345678

# 图谱节点对齐使用的本地向量模型。
BACKEND_GRAPH_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# 可选：GitHub 源码链接搜索的访问令牌，不使用时留空。
BACKEND_GITHUB_TOKEN=

# ES 索引及 LLM 抽取阶段的并发上限；MinerU 和 Neo4j 阶段仍各自串行。
BACKEND_PAPER_EXTRACT_CONCURRENCY=5
